# ── Godot ─────────────────────────────────────────────────────────
.godot/
# NOTE: *.uid files are NOT ignored. Godot 4.4+ generates one per script to
# track identity across renames; committing them keeps scene/script links
# stable for everyone on the project. They are generated by the editor, so
# they only appear after a real import.
/android/
*.translation
export/
*.tmp

# ── Secrets: never commit ─────────────────────────────────────────
build_config.cfg
**/google-services.json
*.keystore
*.jks
export_presets.cfg

# ── Art masters (tracked via LFS or kept out of repo) ─────────────
art/source/**/*.psd
art/source/**/*.xcf

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# Godot export output
export/

# CPU shader previews produced by tools/raster_preview.py — regenerate, never commit
iris_preview_*.png
preview_*.png

# Python bytecode caches — build artefacts, never source.
__pycache__/
*.pyc
